            "text": "[{\"id\":\"evt-festival-2026\",\"title\":\"Festival of Blackrod 2026\",\"orgSlug\":\"horwich-blackrod-community-events-cic\",\"category\":\"Community\",\"start\":\"2026-09-12T12:00:00.000Z\",\"end\":\"2026-09-12T22:00:00.000Z\",\"venue\":\"Blackrod Cricket Club (TBC)\",\"address\":\"Vicarage Road, Blackrod BL6 5AA\",\"description\":\"The Festival of Blackrod returns for 2026 — live music, street food, children's activities, community stalls, fairground rides and games. In 2025 the festival drew around 4,400 attendees. Formally approved in the February 2026 Town Council minutes and listed on the 2026–2027 significant dates schedule. Free to attend.\",\"cost\":\"Free to attend (food/bar payable on site)\",\"age\":\"All ages\",\"accessibility\":\"Outdoor ground — please contact organisers for specific access needs\",\"booking\":\"\",\"contactEmail\":\"clerk@blackrodtowncouncil.gov.uk\",\"contactPhone\":\"01204 696362\",\"image\":\"https://images.unsplash.com/photo-1533174072545-7a4b6ad7a6c3?w=1200&q=80\",\"featured\":true,\"status\":\"approved\"},{\"id\":\"evt-light-switchon-2026\",\"title\":\"Blackrod Christmas Light Switch-On 2026\",\"orgSlug\":\"blackrod-town-council\",\"category\":\"Community\",\"start\":\"2026-11-24T18:30:00.000Z\",\"end\":\"2026-11-24T20:00:00.000Z\",\"venue\":\"TBC — see Town Council updates\",\"address\":\"Blackrod\",\"description\":\"The annual Christmas Light Switch-On returns. Listed on the official Town Council 2026–2027 significant dates schedule. The 2025 switch-on featured festive singing and refreshments afterwards in the Blackhorse Street Gardens — expect a similar warm welcome in 2026.\",\"cost\":\"Free\",\"age\":\"All ages\",\"accessibility\":\"Outdoor village event\",\"booking\":\"\",\"contactEmail\":\"clerk@blackrodtowncouncil.gov.uk\",\"contactPhone\":\"01204 696362\",\"image\":\"https://images.unsplash.com/photo-1606830733744-0ad778449672?w=1200&q=80\",\"featured\":true,\"status\":\"approved\"},{\"id\":\"evt-christmas-market-2026\",\"title\":\"Blackrod Christmas Market 2026\",\"orgSlug\":\"horwich-blackrod-community-events-cic\",\"category\":\"Community\",\"start\":\"2026-11-28T10:00:00.000Z\",\"end\":\"2026-11-28T16:00:00.000Z\",\"venue\":\"Church Street, Blackrod (TBC)\",\"address\":\"Church Street, Blackrod\",\"description\":\"Blackrod's Christmas Market returns in 2026 — local stalls, festive treats and family activities along Church Street. Free to attend, like all HBCE-hosted events in 2025.\",\"cost\":\"Free to attend\",\"age\":\"All ages\",\"accessibility\":\"Outdoor street event\",\"booking\":\"\",\"contactEmail\":\"clerk@blackrodtowncouncil.gov.uk\",\"contactPhone\":\"01204 696362\",\"image\":\"https://images.unsplash.com/photo-1542038784456-1ea8e935640e?w=1200&q=80\",\"featured\":true,\"status\":\"approved\"},{\"id\":\"evt-scarecrow-2025\",\"title\":\"Blackrod Scarecrow Festival\",\"orgSlug\":\"blackrod-scarecrow-festival-committee\",\"category\":\"Community\",\"start\":\"2025-07-05T10:00:00.000Z\",\"end\":\"2025-07-05T19:00:00.000Z\",\"venue\":\"Across Blackrod\",\"address\":\"Blackrod\",\"description\":\"The annual village scarecrow festival, 10am–7pm on both Saturday and Sunday. Includes a Sunday 10k starting at Hilltops. Art group exhibition, knit & natter stall, scarecrows across the village.\",\"cost\":\"Free entry\",\"age\":\"All ages\",\"accessibility\":\"Outdoor village event\",\"booking\":\"\",\"contactEmail\":\"jeanhibbert@virginmedia.com\",\"contactPhone\":\"01204 691575\",\"image\":\"https://images.unsplash.com/photo-1601999103894-79c6c4f6ba0d?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-scarecrow-2025-sun\",\"title\":\"Scarecrow Festival — Sunday 10k\",\"orgSlug\":\"blackrod-scarecrow-festival-committee\",\"category\":\"Sport\",\"start\":\"2025-07-06T10:00:00.000Z\",\"end\":\"2025-07-06T19:00:00.000Z\",\"venue\":\"Starts at Hilltops\",\"address\":\"Hilltops Sports & Social Club, Blackrod\",\"description\":\"Day two of the Scarecrow Festival — including the Sunday 10k starting at Hilltops, plus scarecrows across the village from 10am to 7pm.\",\"cost\":\"Race entry payable; festival viewing free\",\"age\":\"All ages\",\"accessibility\":\"Outdoor\",\"booking\":\"\",\"contactEmail\":\"jeanhibbert@virginmedia.com\",\"contactPhone\":\"01204 691575\",\"image\":\"https://images.unsplash.com/photo-1469571486292-0ba58a3f068b?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-ve80-concert\",\"title\":\"VE Day 80th Anniversary Concert\",\"orgSlug\":\"st-katharines-church\",\"category\":\"Music\",\"start\":\"2025-05-11T19:00:00.000Z\",\"end\":\"2025-05-11T21:00:00.000Z\",\"venue\":\"St Katharine's Church\",\"address\":\"Church Street, Blackrod BL6 5TE\",\"description\":\"A VE Day 80th Anniversary concert — one of the Town Council's two big free-to-attend events for 2025, hosted at St Katharine's in partnership with Horwich & Blackrod Community Events CIC. Ticketed for capacity; sold out on the night.\",\"cost\":\"Free to attend (ticketed, sold out)\",\"age\":\"All ages\",\"accessibility\":\"Step-free entry\",\"booking\":\"\",\"contactEmail\":\"Revawynne@gmail.com\",\"contactPhone\":\"01204 468150\",\"image\":\"https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-easter-egg-hunt-2025\",\"title\":\"Easter Egg Hunt\",\"orgSlug\":\"blackrod-sports-community-centre\",\"category\":\"Family\",\"start\":\"2025-04-18T11:00:00.000Z\",\"end\":\"2025-04-18T13:00:00.000Z\",\"venue\":\"Blackrod Sports & Community Centre\",\"address\":\"Greenbarn Way, Blackrod BL6 5TG\",\"description\":\"Easter Egg Hunt at the BSaCC — registration required; the event was oversubscribed.\",\"cost\":\"Registration required\",\"age\":\"Family\",\"accessibility\":\"Step-free\",\"booking\":\"\",\"contactEmail\":\"bsacc.manager@gmail.com\",\"contactPhone\":\"07980 713289\",\"image\":\"https://images.unsplash.com/photo-1551888419-7b7a520fe0ca?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-mhfa-day1-2025\",\"title\":\"Mental Health First Aid (MHFA) Course — Day 1\",\"orgSlug\":\"blackrod-sports-community-centre\",\"category\":\"Health & Wellbeing\",\"start\":\"2025-02-27T09:00:00.000Z\",\"end\":\"2025-02-27T17:00:00.000Z\",\"venue\":\"Blackrod Sports & Community Centre\",\"address\":\"Greenbarn Way, Blackrod BL6 5TG\",\"description\":\"MHFA England-accredited two-day course (with Real Life Training). Day 1 of 2 (paired with 7 March). Valid 3 years; certificate plus app/membership benefits. Direct booking with the trainer — not a funded course.\",\"cost\":\"Paid — contact trainer for prices\",\"age\":\"Adults\",\"accessibility\":\"Step-free\",\"booking\":\"\",\"contactEmail\":\"bsacc.manager@gmail.com\",\"contactPhone\":\"07980 713289\",\"image\":\"https://images.unsplash.com/photo-1571260899304-425eee4c7efc?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-mhfa-day2-2025\",\"title\":\"Mental Health First Aid (MHFA) Course — Day 2\",\"orgSlug\":\"blackrod-sports-community-centre\",\"category\":\"Health & Wellbeing\",\"start\":\"2025-03-07T09:00:00.000Z\",\"end\":\"2025-03-07T17:00:00.000Z\",\"venue\":\"Blackrod Sports & Community Centre\",\"address\":\"Greenbarn Way, Blackrod BL6 5TG\",\"description\":\"Day 2 of the MHFA England-accredited two-day course (with Real Life Training). Certificate plus app/membership benefits on completion.\",\"cost\":\"Paid — contact trainer for prices\",\"age\":\"Adults\",\"accessibility\":\"Step-free\",\"booking\":\"\",\"contactEmail\":\"bsacc.manager@gmail.com\",\"contactPhone\":\"07980 713289\",\"image\":\"https://images.unsplash.com/photo-1571260899304-425eee4c7efc?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-efaw-apr-2025\",\"title\":\"Emergency First Aid at Work — Open Course\",\"orgSlug\":\"blackrod-sports-community-centre\",\"category\":\"Health & Wellbeing\",\"start\":\"2025-04-24T09:00:00.000Z\",\"end\":\"2025-04-24T17:00:00.000Z\",\"venue\":\"Blackrod Sports & Community Centre\",\"address\":\"Greenbarn Way, Blackrod BL6 5TG\",\"description\":\"Emergency First Aid at Work open course (with Real Life Training). Contact the trainer for prices and availability.\",\"cost\":\"Paid — contact trainer\",\"age\":\"Adults (workplace first aiders)\",\"accessibility\":\"Step-free\",\"booking\":\"\",\"contactEmail\":\"bsacc.manager@gmail.com\",\"contactPhone\":\"07980 713289\",\"image\":\"https://images.unsplash.com/photo-1576765608535-5f04d1e3f289?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-efaw-may-2025\",\"title\":\"Emergency First Aid at Work — May Course\",\"orgSlug\":\"blackrod-sports-community-centre\",\"category\":\"Health & Wellbeing\",\"start\":\"2025-05-22T09:00:00.000Z\",\"end\":\"2025-05-22T17:00:00.000Z\",\"venue\":\"Blackrod Sports & Community Centre\",\"address\":\"Greenbarn Way, Blackrod BL6 5TG\",\"description\":\"EFAW course (with Real Life Training). Contact the trainer for prices.\",\"cost\":\"Paid — contact trainer\",\"age\":\"Adults\",\"accessibility\":\"Step-free\",\"booking\":\"\",\"contactEmail\":\"bsacc.manager@gmail.com\",\"contactPhone\":\"07980 713289\",\"image\":\"https://images.unsplash.com/photo-1576765608535-5f04d1e3f289?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-scarecrow-workshops-2025\",\"title\":\"Scarecrow-Making Workshops\",\"orgSlug\":\"blackrod-scarecrow-festival-committee\",\"category\":\"Family\",\"start\":\"2025-04-12T10:00:00.000Z\",\"end\":\"2025-04-12T13:00:00.000Z\",\"venue\":\"Tree Barn\",\"address\":\"Tree Barn, Blackrod\",\"description\":\"Free scarecrow-making craft workshops in April 2025 in the run-up to the Scarecrow Festival.\",\"cost\":\"Free\",\"age\":\"Family\",\"accessibility\":\"Indoor barn — accessible parking\",\"booking\":\"\",\"contactEmail\":\"jeanhibbert@virginmedia.com\",\"contactPhone\":\"01204 691575\",\"image\":\"https://images.unsplash.com/photo-1604881988758-f76ad2f7aac1?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-remembrance-2025\",\"title\":\"Remembrance Sunday\",\"orgSlug\":\"blackrod-town-council\",\"category\":\"Community\",\"start\":\"2025-11-09T14:00:00.000Z\",\"end\":\"2025-11-09T16:00:00.000Z\",\"venue\":\"Blackrod — civic act and church service\",\"address\":\"Blackrod\",\"description\":\"Public memorial event with civic act and linked church service.\",\"cost\":\"Free\",\"age\":\"All ages\",\"accessibility\":\"Outdoor\",\"booking\":\"\",\"contactEmail\":\"clerk@blackrodtowncouncil.gov.uk\",\"contactPhone\":\"01204 696362\",\"image\":\"https://images.unsplash.com/photo-1542838686-37da4a9fd1a3?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-armistice-2025\",\"title\":\"Armistice Day Service at the Cenotaph\",\"orgSlug\":\"blackrod-town-council\",\"category\":\"Community\",\"start\":\"2025-11-11T11:00:00.000Z\",\"end\":\"2025-11-11T12:00:00.000Z\",\"venue\":\"Blackrod Cenotaph\",\"address\":\"Manchester Road, Blackrod\",\"description\":\"Public Armistice Day service at the Cenotaph.\",\"cost\":\"Free\",\"age\":\"All ages\",\"accessibility\":\"Outdoor\",\"booking\":\"\",\"contactEmail\":\"clerk@blackrodtowncouncil.gov.uk\",\"contactPhone\":\"01204 696362\",\"image\":\"https://images.unsplash.com/photo-1542838686-37da4a9fd1a3?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-light-switchon-2025\",\"title\":\"Blackrod Annual Christmas Light Switch-On 2025\",\"orgSlug\":\"blackrod-town-council\",\"category\":\"Community\",\"start\":\"2025-11-25T18:30:00.000Z\",\"end\":\"2025-11-25T20:00:00.000Z\",\"venue\":\"Blackhorse Street Gardens\",\"address\":\"Blackhorse Street, Blackrod\",\"description\":\"Festive singing and refreshments afterwards. A village favourite.\",\"cost\":\"Free\",\"age\":\"All ages\",\"accessibility\":\"Outdoor\",\"booking\":\"\",\"contactEmail\":\"clerk@blackrodtowncouncil.gov.uk\",\"contactPhone\":\"01204 696362\",\"image\":\"https://images.unsplash.com/photo-1606830733744-0ad778449672?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-christmas-market-2025\",\"title\":\"Blackrod Christmas Market 2025\",\"orgSlug\":\"horwich-blackrod-community-events-cic\",\"category\":\"Community\",\"start\":\"2025-12-20T10:00:00.000Z\",\"end\":\"2025-12-20T16:00:00.000Z\",\"venue\":\"Church Street, Blackrod\",\"address\":\"Church Street, Blackrod\",\"description\":\"Christmas market on Church Street with local stalls, festive treats and 'magical' family activity. Free to attend.\",\"cost\":\"Free to attend\",\"age\":\"All ages\",\"accessibility\":\"Outdoor street\",\"booking\":\"\",\"contactEmail\":\"clerk@blackrodtowncouncil.gov.uk\",\"contactPhone\":\"01204 696362\",\"image\":\"https://images.unsplash.com/photo-1542038784456-1ea8e935640e?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-wiggle-mon\",\"title\":\"Wiggle Worship Baby & Toddler Group\",\"orgSlug\":\"wiggle-worship\",\"category\":\"Family\",\"start\":\"2026-07-13T09:00:00.000Z\",\"end\":\"2026-07-13T11:15:00.000Z\",\"venue\":\"St Katharine's Church\",\"address\":\"Church Street, Blackrod BL6 5TE\",\"description\":\"Term-time Monday morning songs, play and faith stories for babies and toddlers — combined with Baby Rhyme. Free.\",\"cost\":\"Free\",\"age\":\"0 – 4\",\"accessibility\":\"Step-free, baby change\",\"booking\":\"\",\"contactEmail\":\"\",\"contactPhone\":\"07514 041611\",\"image\":\"https://images.unsplash.com/photo-1502086223501-7ea6ecd79368?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-stitchknit-mon\",\"title\":\"St Katharine's Stitch & Knit\",\"orgSlug\":\"st-katharines-stitch-knit\",\"category\":\"Community\",\"start\":\"2026-07-13T10:00:00.000Z\",\"end\":\"2026-07-13T12:00:00.000Z\",\"venue\":\"St Katharine's Upper Room\",\"address\":\"Church Street, Blackrod BL6 5TE\",\"description\":\"Monday morning stitch & knit with around 12–13 regulars. Open to novices and newcomers. Items often made for charitable causes.\",\"cost\":\"Free\",\"age\":\"Adults\",\"accessibility\":\"Step-free, hearing loop\",\"booking\":\"\",\"contactEmail\":\"\",\"contactPhone\":\"\",\"image\":\"https://images.unsplash.com/photo-1517157212532-c5ee2cb55c01?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-connect-tue\",\"title\":\"Connect — Warm Space at St Katharine's\",\"orgSlug\":\"connect-st-katharines\",\"category\":\"Health & Wellbeing\",\"start\":\"2026-07-14T10:30:00.000Z\",\"end\":\"2026-07-14T12:30:00.000Z\",\"venue\":\"St Katharine's Church\",\"address\":\"Church Street, Blackrod BL6 5TE\",\"description\":\"A warm space with free refreshments and a friendly chat. Mainly retired villagers but everyone welcome.\",\"cost\":\"Free\",\"age\":\"Adults\",\"accessibility\":\"Step-free, hearing loop\",\"booking\":\"\",\"contactEmail\":\"\",\"contactPhone\":\"\",\"image\":\"https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-tuesday-communion\",\"title\":\"Tuesday Holy Communion\",\"orgSlug\":\"st-katharines-church\",\"category\":\"Faith\",\"start\":\"2026-07-14T09:30:00.000Z\",\"end\":\"2026-07-14T10:15:00.000Z\",\"venue\":\"St Katharine's Church\",\"address\":\"Church Street, Blackrod BL6 5TE\",\"description\":\"Mid-week Holy Communion service.\",\"cost\":\"Free\",\"age\":\"All ages\",\"accessibility\":\"Step-free, hearing loop\",\"booking\":\"\",\"contactEmail\":\"Revawynne@gmail.com\",\"contactPhone\":\"01204 468150\",\"image\":\"https://images.unsplash.com/photo-1519892300165-cb5542fb47c7?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-knitnatter-sat\",\"title\":\"Knit & Natter at the Library\",\"orgSlug\":\"knit-natter-library\",\"category\":\"Community\",\"start\":\"2026-07-11T10:30:00.000Z\",\"end\":\"2026-07-11T13:00:00.000Z\",\"venue\":\"Blackrod Library\",\"address\":\"Church Street, Blackrod BL6 5EQ\",\"description\":\"Saturday morning knit, stitch and natter at the library. Average 13 attendees.\",\"cost\":\"Free\",\"age\":\"Adults\",\"accessibility\":\"Step-free\",\"booking\":\"\",\"contactEmail\":\"\",\"contactPhone\":\"\",\"image\":\"https://images.unsplash.com/photo-1565693413579-8a73bdee0a2c?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-choir-sat\",\"title\":\"Blackrod Community Choir — Saturday Rehearsal\",\"orgSlug\":\"blackrod-community-choir\",\"category\":\"Music\",\"start\":\"2026-07-11T10:00:00.000Z\",\"end\":\"2026-07-11T11:00:00.000Z\",\"venue\":\"St Katharine's Church\",\"address\":\"Church Street, Blackrod BL6 5TE\",\"description\":\"Friendly community choir — no audition, first session free as a taster. New members always welcome.\",\"cost\":\"Free taster, then small subscription\",\"age\":\"Adults\",\"accessibility\":\"Step-free, hearing loop\",\"booking\":\"\",\"contactEmail\":\"\",\"contactPhone\":\"\",\"image\":\"https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=1200&q=80\",\"featured\":true,\"status\":\"approved\"},{\"id\":\"evt-sunday-eucharist\",\"title\":\"Sunday Eucharist\",\"orgSlug\":\"st-katharines-church\",\"category\":\"Faith\",\"start\":\"2026-07-12T11:00:00.000Z\",\"end\":\"2026-07-12T12:15:00.000Z\",\"venue\":\"St Katharine's Church\",\"address\":\"Church Street, Blackrod BL6 5TE\",\"description\":\"Sunday Eucharist at 11am. Second-Sunday all-age worship at 9.30am.\",\"cost\":\"Free\",\"age\":\"All ages\",\"accessibility\":\"Step-free, hearing loop\",\"booking\":\"\",\"contactEmail\":\"Revawynne@gmail.com\",\"contactPhone\":\"01204 468150\",\"image\":\"https://images.unsplash.com/photo-1519892300165-cb5542fb47c7?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-talking-football-mon\",\"title\":\"Talking Football — Monday Session\",\"orgSlug\":\"talking-football\",\"category\":\"Health & Wellbeing\",\"start\":\"2026-07-13T19:00:00.000Z\",\"end\":\"2026-07-13T20:00:00.000Z\",\"venue\":\"Bolton Arena\",\"address\":\"Bolton Arena, Bolton\",\"description\":\"Men's wellbeing through football — a friendly session with the option to talk if you want to. 200+ men have accessed the group since April 2022.\",\"cost\":\"Free / small contribution\",\"age\":\"Men, all ages\",\"accessibility\":\"Indoor pitches\",\"booking\":\"\",\"contactEmail\":\"\",\"contactPhone\":\"\",\"image\":\"https://images.unsplash.com/photo-1517649763962-0c623066013b?w=1200&q=80\",\"featured\":true,\"status\":\"approved\"},{\"id\":\"evt-talking-football-wed\",\"title\":\"Talking Football — Wednesday Session\",\"orgSlug\":\"talking-football\",\"category\":\"Health & Wellbeing\",\"start\":\"2026-07-15T19:00:00.000Z\",\"end\":\"2026-07-15T20:00:00.000Z\",\"venue\":\"Bolton Arena\",\"address\":\"Bolton Arena, Bolton\",\"description\":\"Men's wellbeing football — Wednesday session.\",\"cost\":\"Free / small contribution\",\"age\":\"Men, all ages\",\"accessibility\":\"Indoor pitches\",\"booking\":\"\",\"contactEmail\":\"\",\"contactPhone\":\"\",\"image\":\"https://images.unsplash.com/photo-1517649763962-0c623066013b?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-bloomers-wed\",\"title\":\"Blackrod Bloomers — Wednesday Planting\",\"orgSlug\":\"blackrod-bloomers\",\"category\":\"Volunteering\",\"start\":\"2026-07-15T08:00:00.000Z\",\"end\":\"2026-07-15T10:00:00.000Z\",\"venue\":\"Around the village\",\"address\":\"Blackrod\",\"description\":\"Volunteer planting and maintenance across the village gateways and planters.\",\"cost\":\"Free — volunteers welcome\",\"age\":\"All ages (with help for under-12s)\",\"accessibility\":\"Outdoor\",\"booking\":\"\",\"contactEmail\":\"clerk@blackrodtowncouncil.gov.uk\",\"contactPhone\":\"01204 696362\",\"image\":\"https://images.unsplash.com/photo-1466692476868-aef1dfb1e735?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-bloomers-fri\",\"title\":\"Blackrod Bloomers — Friday Planting\",\"orgSlug\":\"blackrod-bloomers\",\"category\":\"Volunteering\",\"start\":\"2026-07-10T08:00:00.000Z\",\"end\":\"2026-07-10T10:00:00.000Z\",\"venue\":\"Around the village\",\"address\":\"Blackrod\",\"description\":\"Friday morning planting/maintenance with the Bloomers.\",\"cost\":\"Free — volunteers welcome\",\"age\":\"All ages\",\"accessibility\":\"Outdoor\",\"booking\":\"\",\"contactEmail\":\"clerk@blackrodtowncouncil.gov.uk\",\"contactPhone\":\"01204 696362\",\"image\":\"https://images.unsplash.com/photo-1466692476868-aef1dfb1e735?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-twilight-bookclub\",\"title\":\"Twilight Book Club\",\"orgSlug\":\"twilight-book-club\",\"category\":\"Community\",\"start\":\"2026-07-23T17:45:00.000Z\",\"end\":\"2026-07-23T19:00:00.000Z\",\"venue\":\"Blackrod Library\",\"address\":\"Church Street, Blackrod BL6 5EQ\",\"description\":\"Third-Thursday evening book club at the library. Average 10–15 readers.\",\"cost\":\"Free\",\"age\":\"Adults\",\"accessibility\":\"Step-free\",\"booking\":\"\",\"contactEmail\":\"\",\"contactPhone\":\"\",\"image\":\"https://images.unsplash.com/photo-1481627834876-b7833e8f5570?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-reading-club\",\"title\":\"St Katharine's Monday Night Reading Club\",\"orgSlug\":\"monday-night-reading-club\",\"category\":\"Community\",\"start\":\"2026-08-03T19:30:00.000Z\",\"end\":\"2026-08-03T21:00:00.000Z\",\"venue\":\"St Katharine's Church\",\"address\":\"Church Street, Blackrod BL6 5TE\",\"description\":\"Last-Monday-of-the-month evening reading club. Free and open to new members.\",\"cost\":\"Free\",\"age\":\"Adults\",\"accessibility\":\"Step-free\",\"booking\":\"\",\"contactEmail\":\"\",\"contactPhone\":\"\",\"image\":\"https://images.unsplash.com/photo-1521587760476-6c12a4b040da?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-messy-church\",\"title\":\"Messy Church\",\"orgSlug\":\"messy-church-st-katharines\",\"category\":\"Family\",\"start\":\"2026-08-01T16:00:00.000Z\",\"end\":\"2026-08-01T18:00:00.000Z\",\"venue\":\"St Katharine's Church\",\"address\":\"Church Street, Blackrod BL6 5TE\",\"description\":\"Last-Saturday family Messy Church — craft, story, song and a meal. Around 30–35 children, 30 adults, 20 volunteers.\",\"cost\":\"Free\",\"age\":\"Family\",\"accessibility\":\"Step-free, baby change\",\"booking\":\"\",\"contactEmail\":\"\",\"contactPhone\":\"\",\"image\":\"https://images.unsplash.com/photo-1503454537195-1dcabb73ffb9?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-history-meeting\",\"title\":\"Blackrod Local History Group — Monthly Meeting\",\"orgSlug\":\"blackrod-local-history-group\",\"category\":\"Heritage\",\"start\":\"2026-07-18T19:30:00.000Z\",\"end\":\"2026-07-18T21:00:00.000Z\",\"venue\":\"Blackrod Library / Council Chamber\",\"address\":\"Church Street, Blackrod BL6 5EQ\",\"description\":\"Monthly local history talk. £1 entry or £10 annual membership — refreshments included. Average attendance about 40.\",\"cost\":\"£1 entry or £10 annual\",\"age\":\"Adults\",\"accessibility\":\"Step-free\",\"booking\":\"\",\"contactEmail\":\"\",\"contactPhone\":\"\",\"image\":\"https://images.unsplash.com/photo-1521587760476-6c12a4b040da?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-walking-group\",\"title\":\"Blackrod Community Walking Group — Monthly Walk\",\"orgSlug\":\"blackrod-community-walking-group\",\"category\":\"Health & Wellbeing\",\"start\":\"2026-07-11T10:00:00.000Z\",\"end\":\"2026-07-11T13:00:00.000Z\",\"venue\":\"Meet point on group page\",\"address\":\"Blackrod\",\"description\":\"A monthly local walk with the option of lunch afterwards. Friendly, sociable pace.\",\"cost\":\"Free\",\"age\":\"Adults\",\"accessibility\":\"Outdoor — pace varies\",\"booking\":\"\",\"contactEmail\":\"\",\"contactPhone\":\"\",\"image\":\"https://images.unsplash.com/photo-1551632811-561732d1e306?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-pending-art\",\"title\":\"Art Group — Annual Library Exhibition Opening (Pending)\",\"orgSlug\":\"blackrod-art-group\",\"category\":\"Community\",\"start\":\"2026-07-28T18:00:00.000Z\",\"end\":\"2026-07-28T20:00:00.000Z\",\"venue\":\"Blackrod Library\",\"address\":\"Church Street, Blackrod BL6 5EQ\",\"description\":\"Opening evening of the Blackrod Art Group's 12-week library exhibition.\",\"cost\":\"Free\",\"age\":\"All ages\",\"accessibility\":\"Step-free\",\"booking\":\"\",\"contactEmail\":\"blackrodartgroup@gmail.com\",\"contactPhone\":\"07894 904100\",\"image\":\"https://images.unsplash.com/photo-1513364776144-60967b0f800f?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"4b184c73-e915-4c14-bbbc-19115ef659d1\",\"title\":\"RBL Blackrod 90th Anniversary Masquerade Ball\",\"orgSlug\":\"royal-british-legion-blackrod-brach\",\"category\":\"Community\",\"start\":\"2026-10-31T19:30:00.000Z\",\"end\":\"2026-10-31T23:59:00.000Z\",\"venue\":\"Hawthorns, Douglas Valley Golf Club\",\"address\":\"BL6 5HF\",\"description\":\"Celebrate 90 years of RBL Blackrod Branch service at this special Masquerade Ball welcoming local dignitaries. Dress to impress in suits, tuxedos, cocktail or ball gowns. Tickets are limited and available first-come, first-served via email.\",\"cost\":\"Free\",\"age\":\"All ages\",\"accessibility\":\"Please contact us for details\",\"booking\":\"\",\"contactEmail\":\"blackrodrbl@outlook.com\",\"contactPhone\":\"\",\"image\":\"https://images.unsplash.com/photo-1533174072545-7a4b6ad7a6c3?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"16c16c65-b5e2-4811-b3f1-1a135c1c0284\",\"title\":\"Baby Babble and Bond — Blackrod Young People's Centre\",\"orgSlug\":\"blackrod-young-peoples-centre\",\"category\":\"Family\",\"start\":\"2026-07-22T09:00:00.000Z\",\"end\":\"2026-07-22T10:00:00.000Z\",\"venue\":\"Blackrod Young People's Centre, BL6 5SY\",\"address\":\"Blackrod Young People's Centre, BL6 5SY\",\"description\":\"Drop-in fun and interactive group for families with babies 0–12 months. Songs, rhymes, sensory play, and chats on weaning, development, and oral health. Run by Family Hub Practitioners. *Weekly except 26 Aug (Tuesdays).\",\"cost\":\"Free\",\"age\":\"\",\"accessibility\":\"\",\"booking\":\"\",\"contactEmail\":\"\",\"contactPhone\":\"\",\"image\":\"\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"32b49222-773a-4df7-9d99-44c903b08231\",\"title\":\"Chat, Play, Read — Blackrod Young People's Centre\",\"orgSlug\":\"blackrod-young-peoples-centre\",\"category\":\"Family\",\"start\":\"2026-07-22T09:00:00.000Z\",\"end\":\"2026-07-22T10:00:00.000Z\",\"venue\":\"Blackrod Young People's Centre, BL6 5SY\",\"address\":\"Blackrod Young People's Centre, BL6 5SY\",\"description\":\"Interactive group for families with children 12 months+. Songs, stories, sensory play, and craft to build communication, language, and literacy. Includes special REAL literacy activity session on 28 Jul. *Weekly except 25 Aug (Tuesdays).\",\"cost\":\"Free\",\"age\":\"\",\"accessibility\":\"\",\"booking\":\"\",\"contactEmail\":\"\",\"contactPhone\":\"\",\"image\":\"\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"b453b68b-b6fe-4d4e-8711-0c8b5be12f1d\",\"title\":\"Bumps, Boobs, and Buggies Walking Group\",\"orgSlug\":\"blackrod-town-council\",\"category\":\"Health & Wellbeing\",\"start\":\"2026-07-21T09:00:00.000Z\",\"end\":\"2026-07-21T10:00:00.000Z\",\"venue\":\"Horwich Library\",\"address\":\"Horwich Library\",\"description\":\"Gentle Monday morning walk suitable for prams, toddlers, and slings. A great way to get fresh air, boost wellbeing, and meet other mums. *Weekly Mondays.\",\"cost\":\"Free\",\"age\":\"\",\"accessibility\":\"\",\"booking\":\"\",\"contactEmail\":\"\",\"contactPhone\":\"\",\"image\":\"\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"ca429cf0-3053-473f-aa92-7f449995bc3d\",\"title\":\"Breastfeeding Group — Horwich Library\",\"orgSlug\":\"blackrod-town-council\",\"category\":\"Health & Wellbeing\",\"start\":\"2026-07-21T10:00:00.000Z\",\"end\":\"2026-07-21T11:00:00.000Z\",\"venue\":\"Horwich Library\",\"address\":\"Horwich Library\",\"description\":\"Drop-in group for breastfeeding parents. Come along to meet others, socialise, and access peer support. *Weekly Mondays.\",\"cost\":\"Free\",\"age\":\"\",\"accessibility\":\"\",\"booking\":\"\",\"contactEmail\":\"\",\"contactPhone\":\"\",\"image\":\"\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"9dd6d86a-8fcb-45b0-9f9b-8642dac26f1f\",\"title\":\"Toddler Tales — Blackrod & Horwich Libraries\",\"orgSlug\":\"blackrod-town-council\",\"category\":\"Family\",\"start\":\"2026-07-23T09:30:00.000Z\",\"end\":\"2026-07-23T09:30:00.000Z\",\"venue\":\"Blackrod Library & Horwich Library\",\"address\":\"Blackrod Library & Horwich Library\",\"description\":\"Storytelling sessions for young children (ideal 2–5 years), mums, dads, and carers. No booking required. Continues in school holidays. *Weekly Thursdays.\",\"cost\":\"Free\",\"age\":\"\",\"accessibility\":\"\",\"booking\":\"\",\"contactEmail\":\"\",\"contactPhone\":\"\",\"image\":\"\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"e3c3e2cc-4fc7-43c5-9ad3-924c700b3359\",\"title\":\"Baby Babble and Bond — Horwich Health and Wellbeing Hub\",\"orgSlug\":\"blackrod-town-council\",\"category\":\"Family\",\"start\":\"2026-07-25T08:30:00.000Z\",\"end\":\"2026-07-25T09:30:00.000Z\",\"venue\":\"Horwich Health and Wellbeing Hub\",\"address\":\"Horwich Health and Wellbeing Hub\",\"description\":\"Drop-in interactive group for families with babies 0–12 months. Songs, rhymes, sensory play, and topic chats. *Two sessions Fridays: 9:30am and 1:00pm. Not running 28 Aug.\",\"cost\":\"Free\",\"age\":\"\",\"accessibility\":\"\",\"booking\":\"\",\"contactEmail\":\"\",\"contactPhone\":\"\",\"image\":\"\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"054de93e-fe35-43ed-9a4a-3c065c57fb1b\",\"title\":\"Summer REAL Activities — Blackrod Young People's Centre\",\"orgSlug\":\"blackrod-young-peoples-centre\",\"category\":\"Family\",\"start\":\"2026-07-28T09:00:00.000Z\",\"end\":\"2026-07-28T10:00:00.000Z\",\"venue\":\"Blackrod Young People's Centre, BL6 5SY\",\"address\":\"Blackrod Young People's Centre, BL6 5SY\",\"description\":\"Special summertime REAL literacy activity session for ages 3–4 (all families welcome). Logo hunts, storytime, and messy play. Take home simple, low‑cost ideas to support literacy. No booking required.\",\"cost\":\"Free\",\"age\":\"\",\"accessibility\":\"\",\"booking\":\"\",\"contactEmail\":\"\",\"contactPhone\":\"\",\"image\":\"\",\"featured\":false,\"status\":\"approved\"}]"
