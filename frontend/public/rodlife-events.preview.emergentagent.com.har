          "cookies": [],
          "content": {
            "size": 3293,
            "mimeType": "application/json",
            "text": "[{\"id\":\"vol-bloomers\",\"title\":\"Volunteer Gardener — Blackrod Bloomers\",\"orgSlug\":\"blackrod-bloomers\",\"description\":\"Help plant and maintain Blackrod's gateways, planters and flower beds. Welcoming team of 7 — always open to new volunteers and donations.\",\"age\":\"All ages (with help for under-12s)\",\"time\":\"Wednesdays & Fridays 8am (a couple of hours)\",\"skills\":\"Reliable, happy outdoors — no experience needed\"},{\"id\":\"vol-messy-church\",\"title\":\"Messy Church Helper\",\"orgSlug\":\"messy-church-st-katharines\",\"description\":\"Join the team of ~20 volunteers running monthly Messy Church for 30+ children and their families. Great for DofE Volunteering section.\",\"age\":\"14+\",\"time\":\"Last Saturday of the month, 3pm – 6.30pm\",\"skills\":\"Friendly, enjoy working with families\"},{\"id\":\"vol-knit-charity\",\"title\":\"Charity Knitter — Stitch & Knit\",\"orgSlug\":\"st-katharines-stitch-knit\",\"description\":\"Help make and finish items to sell at community events for charitable causes. Open to novices.\",\"age\":\"16+\",\"time\":\"Mondays 10am – 12 noon\",\"skills\":\"Willing to learn — happy to chat\"},{\"id\":\"vol-art-group\",\"title\":\"Art Group Exhibition Steward\",\"orgSlug\":\"blackrod-art-group\",\"description\":\"Steward the Scarecrow Festival weekend exhibition and the 12-week library exhibition.\",\"age\":\"16+\",\"time\":\"Occasional days through the year\",\"skills\":\"Friendly, comfortable chatting to visitors\"},{\"id\":\"vol-wiggle\",\"title\":\"Wiggle Worship & Baby Rhyme Volunteer\",\"orgSlug\":\"wiggle-worship\",\"description\":\"Help with songs, refreshments and welcoming new families. Great Skills/Volunteering pick for DofE.\",\"age\":\"14+\",\"time\":\"Monday mornings in term time\",\"skills\":\"Patient, friendly, enjoy babies and toddlers\"},{\"id\":\"vol-choir\",\"title\":\"Community Choir New Member (taster welcome)\",\"orgSlug\":\"blackrod-community-choir\",\"description\":\"Not a volunteer role exactly — join the choir! First session free, no audition, all welcome.\",\"age\":\"All ages\",\"time\":\"Saturdays 10am – 11am\",\"skills\":\"Just enjoy singing\"},{\"id\":\"vol-history\",\"title\":\"Local History Newsletter Helper\",\"orgSlug\":\"blackrod-local-history-group\",\"description\":\"Help compile the monthly newsletter (sent to 80+ email addresses) and assist on meeting nights.\",\"age\":\"18+\",\"time\":\"A few hours each month\",\"skills\":\"Comfortable with email; interest in local history\"},{\"id\":\"vol-walking\",\"title\":\"Walking Group Buddy\",\"orgSlug\":\"blackrod-community-walking-group\",\"description\":\"Help lead or support our monthly community walks — particularly welcoming to less confident walkers.\",\"age\":\"18+\",\"time\":\"Monthly\",\"skills\":\"Friendly and patient pace; basic first-aid useful\"},{\"id\":\"vol-young-peoples-centre\",\"title\":\"Youth Centre Helper\",\"orgSlug\":\"blackrod-young-peoples-centre\",\"description\":\"Help run free junior and senior youth club sessions for children aged 4 – 17 (reception+).\",\"age\":\"16+\",\"time\":\"Evenings/weekends\",\"skills\":\"DBS-checked or willing to be; warm with young people\"},{\"id\":\"vol-festival\",\"title\":\"Festival of Blackrod Volunteer 2026\",\"orgSlug\":\"horwich-blackrod-community-events-cic\",\"description\":\"Join the team behind Blackrod's biggest day out — 12 September 2026. Set-up, stewarding, info point.\",\"age\":\"16+\",\"time\":\"Saturday 12 September 2026\",\"skills\":\"Friendly, reliable, happy to be on your feet\"}]"
          },
