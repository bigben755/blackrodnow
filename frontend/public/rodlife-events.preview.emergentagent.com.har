          "content": {
            "size": 27963,
            "mimeType": "application/json",
            "text": "[{\"id\":\"evt-festival-2026\",\"title\":\"Festival of Blackrod 2026\",\"orgSlug\":\"horwich-blackrod-community-events-cic\",\"category\":\"Community\",\"start\":\"2026-09-12T12:00:00.000Z\",\"end\":\"2026-09-12T22:00:00.000Z\",\"venue\":\"Blackrod Cricket Club (TBC)\",\"address\":\"Vicarage Road, Blackrod BL6 5AA\",\"description\":\"The Festival of Blackrod returns for 2026 — live music, street food, children's activities, community stalls, fairground rides and games. In 2025 the festival drew around 4,400 attendees. Formally approved in the February 2026 Town Council minutes and listed on the 2026–2027 significant dates schedule. Free to attend.\",\"cost\":\"Free to attend (food/bar payable on site)\",\"age\":\"All ages\",\"accessibility\":\"Outdoor ground — please contact organisers for specific access needs\",\"booking\":\"\",\"contactEmail\":\"clerk@blackrodtowncouncil.gov.uk\",\"contactPhone\":\"01204 696362\",\"image\":\"https://images.unsplash.com/photo-1533174072545-7a4b6ad7a6c3?w=1200&q=80\",\"featured\":true,\"status\":\"approved\"},{\"id\":\"evt-light-switchon-2026\",\"title\":\"Blackrod Christmas Light Switch-On 2026\",\"orgSlug\":\"blackrod-town-council\",\"category\":\"Community\",\"start\":\"2026-11-24T18:30:00.000Z\",\"end\":\"2026-11-24T20:00:00.000Z\",\"venue\":\"TBC — see Town Council updates\",\"address\":\"Blackrod\",\"description\":\"The annual Christmas Light Switch-On returns. Listed on the official Town Council 2026–2027 significant dates schedule. The 2025 switch-on featured festive singing and refreshments afterwards in the Blackhorse Street Gardens — expect a similar warm welcome in 2026.\",\"cost\":\"Free\",\"age\":\"All ages\",\"accessibility\":\"Outdoor village event\",\"booking\":\"\",\"contactEmail\":\"clerk@blackrodtowncouncil.gov.uk\",\"contactPhone\":\"01204 696362\",\"image\":\"https://images.unsplash.com/photo-1606830733744-0ad778449672?w=1200&q=80\",\"featured\":true,\"status\":\"approved\"},{\"id\":\"evt-christmas-market-2026\",\"title\":\"Blackrod Christmas Market 2026\",\"orgSlug\":\"horwich-blackrod-community-events-cic\",\"category\":\"Community\",\"start\":\"2026-11-28T10:00:00.000Z\",\"end\":\"2026-11-28T16:00:00.000Z\",\"venue\":\"Church Street, Blackrod (TBC)\",\"address\":\"Church Street, Blackrod\",\"description\":\"Blackrod's Christmas Market returns in 2026 — local stalls, festive treats and family activities along Church Street. Free to attend, like all HBCE-hosted events in 2025.\",\"cost\":\"Free to attend\",\"age\":\"All ages\",\"accessibility\":\"Outdoor street event\",\"booking\":\"\",\"contactEmail\":\"clerk@blackrodtowncouncil.gov.uk\",\"contactPhone\":\"01204 696362\",\"image\":\"https://images.unsplash.com/photo-1542038784456-1ea8e935640e?w=1200&q=80\",\"featured\":true,\"status\":\"approved\"},{\"id\":\"evt-scarecrow-2025\",\"title\":\"Blackrod Scarecrow Festival\",\"orgSlug\":\"blackrod-scarecrow-festival-committee\",\"category\":\"Community\",\"start\":\"2025-07-05T10:00:00.000Z\",\"end\":\"2025-07-05T19:00:00.000Z\",\"venue\":\"Across Blackrod\",\"address\":\"Blackrod\",\"description\":\"The annual village scarecrow festival, 10am–7pm on both Saturday and Sunday. Includes a Sunday 10k starting at Hilltops. Art group exhibition, knit & natter stall, scarecrows across the village.\",\"cost\":\"Free entry\",\"age\":\"All ages\",\"accessibility\":\"Outdoor village event\",\"booking\":\"\",\"contactEmail\":\"jeanhibbert@virginmedia.com\",\"contactPhone\":\"01204 691575\",\"image\":\"https://images.unsplash.com/photo-1601999103894-79c6c4f6ba0d?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-scarecrow-2025-sun\",\"title\":\"Scarecrow Festival — Sunday 10k\",\"orgSlug\":\"blackrod-scarecrow-festival-committee\",\"category\":\"Sport\",\"start\":\"2025-07-06T10:00:00.000Z\",\"end\":\"2025-07-06T19:00:00.000Z\",\"venue\":\"Starts at Hilltops\",\"address\":\"Hilltops Sports & Social Club, Blackrod\",\"description\":\"Day two of the Scarecrow Festival — including the Sunday 10k starting at Hilltops, plus scarecrows across the village from 10am to 7pm.\",\"cost\":\"Race entry payable; festival viewing free\",\"age\":\"All ages\",\"accessibility\":\"Outdoor\",\"booking\":\"\",\"contactEmail\":\"jeanhibbert@virginmedia.com\",\"contactPhone\":\"01204 691575\",\"image\":\"https://images.unsplash.com/photo-1469571486292-0ba58a3f068b?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-ve80-concert\",\"title\":\"VE Day 80th Anniversary Concert\",\"orgSlug\":\"st-katharines-church\",\"category\":\"Music\",\"start\":\"2025-05-11T19:00:00.000Z\",\"end\":\"2025-05-11T21:00:00.000Z\",\"venue\":\"St Katharine's Church\",\"address\":\"Church Street, Blackrod BL6 5TE\",\"description\":\"A VE Day 80th Anniversary concert — one of the Town Council's two big free-to-attend events for 2025, hosted at St Katharine's in partnership with Horwich & Blackrod Community Events CIC. Ticketed for capacity; sold out on the night.\",\"cost\":\"Free to attend (ticketed, sold out)\",\"age\":\"All ages\",\"accessibility\":\"Step-free entry\",\"booking\":\"\",\"contactEmail\":\"Revawynne@gmail.com\",\"contactPhone\":\"01204 468150\",\"image\":\"https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-easter-egg-hunt-2025\",\"title\":\"Easter Egg Hunt\",\"orgSlug\":\"blackrod-sports-community-centre\",\"category\":\"Family\",\"start\":\"2025-04-18T11:00:00.000Z\",\"end\":\"2025-04-18T13:00:00.000Z\",\"venue\":\"Blackrod Sports & Community Centre\",\"address\":\"Greenbarn Way, Blackrod BL6 5TG\",\"description\":\"Easter Egg Hunt at the BSaCC — registration required; the event was oversubscribed.\",\"cost\":\"Registration required\",\"age\":\"Family\",\"accessibility\":\"Step-free\",\"booking\":\"\",\"contactEmail\":\"bsacc.manager@gmail.com\",\"contactPhone\":\"07980 713289\",\"image\":\"https://images.unsplash.com/photo-1551888419-7b7a520fe0ca?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-mhfa-day1-2025\",\"title\":\"Mental Health First Aid (MHFA) Course — Day 1\",\"orgSlug\":\"blackrod-sports-community-centre\",\"category\":\"Health & Wellbeing\",\"start\":\"2025-02-27T09:00:00.000Z\",\"end\":\"2025-02-27T17:00:00.000Z\",\"venue\":\"Blackrod Sports & Community Centre\",\"address\":\"Greenbarn Way, Blackrod BL6 5TG\",\"description\":\"MHFA England-accredited two-day course (with Real Life Training). Day 1 of 2 (paired with 7 March). Valid 3 years; certificate plus app/membership benefits. Direct booking with the trainer — not a funded course.\",\"cost\":\"Paid — contact trainer for prices\",\"age\":\"Adults\",\"accessibility\":\"Step-free\",\"booking\":\"\",\"contactEmail\":\"bsacc.manager@gmail.com\",\"contactPhone\":\"07980 713289\",\"image\":\"https://images.unsplash.com/photo-1571260899304-425eee4c7efc?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-mhfa-day2-2025\",\"title\":\"Mental Health First Aid (MHFA) Course — Day 2\",\"orgSlug\":\"blackrod-sports-community-centre\",\"category\":\"Health & Wellbeing\",\"start\":\"2025-03-07T09:00:00.000Z\",\"end\":\"2025-03-07T17:00:00.000Z\",\"venue\":\"Blackrod Sports & Community Centre\",\"address\":\"Greenbarn Way, Blackrod BL6 5TG\",\"description\":\"Day 2 of the MHFA England-accredited two-day course (with Real Life Training). Certificate plus app/membership benefits on completion.\",\"cost\":\"Paid — contact trainer for prices\",\"age\":\"Adults\",\"accessibility\":\"Step-free\",\"booking\":\"\",\"contactEmail\":\"bsacc.manager@gmail.com\",\"contactPhone\":\"07980 713289\",\"image\":\"https://images.unsplash.com/photo-1571260899304-425eee4c7efc?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-efaw-apr-2025\",\"title\":\"Emergency First Aid at Work — Open Course\",\"orgSlug\":\"blackrod-sports-community-centre\",\"category\":\"Health & Wellbeing\",\"start\":\"2025-04-24T09:00:00.000Z\",\"end\":\"2025-04-24T17:00:00.000Z\",\"venue\":\"Blackrod Sports & Community Centre\",\"address\":\"Greenbarn Way, Blackrod BL6 5TG\",\"description\":\"Emergency First Aid at Work open course (with Real Life Training). Contact the trainer for prices and availability.\",\"cost\":\"Paid — contact trainer\",\"age\":\"Adults (workplace first aiders)\",\"accessibility\":\"Step-free\",\"booking\":\"\",\"contactEmail\":\"bsacc.manager@gmail.com\",\"contactPhone\":\"07980 713289\",\"image\":\"https://images.unsplash.com/photo-1576765608535-5f04d1e3f289?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-efaw-may-2025\",\"title\":\"Emergency First Aid at Work — May Course\",\"orgSlug\":\"blackrod-sports-community-centre\",\"category\":\"Health & Wellbeing\",\"start\":\"2025-05-22T09:00:00.000Z\",\"end\":\"2025-05-22T17:00:00.000Z\",\"venue\":\"Blackrod Sports & Community Centre\",\"address\":\"Greenbarn Way, Blackrod BL6 5TG\",\"description\":\"EFAW course (with Real Life Training). Contact the trainer for prices.\",\"cost\":\"Paid — contact trainer\",\"age\":\"Adults\",\"accessibility\":\"Step-free\",\"booking\":\"\",\"contactEmail\":\"bsacc.manager@gmail.com\",\"contactPhone\":\"07980 713289\",\"image\":\"https://images.unsplash.com/photo-1576765608535-5f04d1e3f289?w=1200&q=80\",\"featured\":false,\"status\":\"approved\"},{\"id\":\"evt-scarecrow-workshops-2025\",\"title\":\"Scarecrow-Making Workshops\",\"orgSlug\":\"blackrod-scarecrow-festival-committee\",\"category\":\"Family\",\"start\":\"2025-04-12T10:00:00.000Z\",\"end\":\"2025-04-12T13:00:00.000Z\",\"venue\":\"Tree Barn\",\"address\":\"Tree Barn, Blackrod\",\"description\":\"Free scarecrow-making craft workshops in April 2025 in the run-up to the Scarecrow Festival.\",\"cost\":\"Free\",\"age\":\"Family\",\"accessibility\":\"Indoor barn — accessible parking\",\"booking\":\"\",\"contactEmail\":\"jeanhibbert@virginmedia.com\",\"contactPhone\":\"01204 691575\",\"image\":\"https://images